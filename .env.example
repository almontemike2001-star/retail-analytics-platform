# BeanFlow Coffee - local environment template
# Copy this file:
# cp .env.example .env
#
# Never commit .env or credential files.

# PostgreSQL source system
POSTGRES_HOST=localhost
POSTGRES_DB=beanflow
POSTGRES_USER=beanflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433

# Phase 2: simulator (optional)
# BEANFLOW_SIM_SEED=42
# BEANFLOW_SIM_PROFILE=dev

# Phase 3: BigQuery non-secret settings
# Authentication uses Application Default Credentials.
# See docs/setup_gcp.md.
GCP_PROJECT_ID=
BQ_LOCATION=asia-southeast1
BQ_RAW_DATASET=raw_pos
BQ_AUDIT_DATASET=dq_audit
