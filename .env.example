# BeanFlow Coffee - local environment template
# Copy this file:
# cp .env.example .env
#
# Never commit .env.

POSTGRES_HOST=localhost
POSTGRES_DB=beanflow
POSTGRES_USER=beanflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433

